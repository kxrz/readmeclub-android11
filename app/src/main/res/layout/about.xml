<?xml version="1.0" encoding="utf-8"?>
<!-- About, on four pages (no scrolling): readme.club, Help, Member account, The app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingLeft="20dp"
            android:paddingTop="16dp"
            android:paddingRight="20dp">

            <!-- 1. readme.club -->
            <LinearLayout
                android:id="@+id/page_club"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp">

                    <!-- Long press: Lights out. -->
                    <ImageView
                        android:id="@+id/about_logo"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitStart"
                        android:src="@drawable/logo" />

                    <!-- Two decorations, right of the logo (brand: plus and ring). -->
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_marginRight="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ds_deco_plus" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom|end"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ds_deco_ring" />
                </FrameLayout>

                <TextView style="@style/Ds.Sticker" android:layout_marginTop="12dp" android:text="@string/about_sticker" />

                <TextView style="@style/Ds.Title" android:layout_marginTop="12dp" android:text="@string/about_promise" />

                <TextView style="@style/Ds.Text" android:layout_marginTop="10dp" android:textSize="15sp" android:text="@string/about_body" />

                <TextView style="@style/Ds.Label" android:layout_marginTop="18dp" android:text="@string/about_made_by" />

                <TextView style="@style/Ds.Text" android:layout_marginTop="4dp" android:textSize="15sp" android:text="@string/about_thanks" />
            </LinearLayout>

            <!-- 2. Help: the contact form, filled in with this reader's details. -->
            <LinearLayout
                android:id="@+id/page_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/Ds.Title" android:text="@string/about_help_title" />

                <TextView style="@style/Ds.Text" android:layout_marginTop="8dp" android:textSize="15sp" android:text="@string/about_help_body" />

                <ImageView
                    android:id="@+id/help_qr"
                    android:layout_width="168dp"
                    android:layout_height="168dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/about_help_url"
                    android:scaleType="fitCenter" />

                <TextView style="@style/Ds.Text" android:gravity="center" android:textSize="15sp" android:textStyle="bold" android:text="@string/about_help_url" />

                <LinearLayout
                    style="@style/Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView style="@style/Ds.Label" android:text="@string/about_this_reader" />

                    <TextView android:id="@+id/reader_details" style="@style/Ds.Mono" android:layout_marginTop="4dp" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Member account -->
            <LinearLayout
                android:id="@+id/page_member"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:id="@+id/member_title" style="@style/Ds.Title" />

                <TextView android:id="@+id/member_body" style="@style/Ds.Text" android:layout_marginTop="8dp" android:textSize="15sp" />

                <ImageView
                    android:id="@+id/join_qr"
                    android:layout_width="168dp"
                    android:layout_height="168dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/about_account_url"
                    android:scaleType="fitCenter"
                    android:src="@drawable/qr_join" />

                <TextView android:id="@+id/join_url" style="@style/Ds.Text" android:gravity="center" android:textSize="15sp" android:textStyle="bold" android:text="@string/about_account_url" />
            </LinearLayout>

            <!-- 4. The app -->
            <LinearLayout
                android:id="@+id/page_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    style="@style/Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/Ds.Label" android:text="@string/about_version_label" />

                    <TextView android:id="@+id/app_version" style="@style/Ds.Mono" android:textSize="32sp" />

                    <TextView style="@style/Ds.Text" android:layout_marginTop="4dp" android:textSize="15sp" android:text="@string/about_app_promise" />
                </LinearLayout>

                <TextView style="@style/Ds.Label" android:layout_marginTop="20dp" android:text="@string/about_credits" />

                <TextView style="@style/Ds.Text" android:layout_marginTop="4dp" android:textSize="15sp" android:text="@string/about_credits_body" />

                <!-- GPL-3.0 notice; the attribution must stay in any distributed version (NOTICE). -->
                <TextView style="@style/Ds.Text" android:layout_marginTop="16dp" android:textSize="12sp" android:text="@string/about_license" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout style="@style/Ds.Bar">

            <TextView android:id="@+id/back" style="@style/Ds.Button" android:text="@string/back" />

            <TextView android:id="@+id/previous" style="@style/Ds.Button" android:layout_marginLeft="6dp" android:text="@string/previous" />

            <TextView android:id="@+id/page_label" style="@style/Ds.BarStatus" />

            <TextView android:id="@+id/next" style="@style/Ds.Button.Primary" android:text="@string/next" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
