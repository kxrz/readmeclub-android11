<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/page_promise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Long press: Lights Out easter egg. -->
                <ImageView
                    android:id="@+id/about_logo"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitStart"
                    android:src="@drawable/logo" />

                <TextView style="@style/Heading" android:text="@string/about_promise" />

                <TextView style="@style/Body" android:textSize="16sp" android:text="@string/about_body" />

                <TextView style="@style/Body" android:textSize="16sp" android:textStyle="bold" android:paddingTop="12dp" android:text="@string/about_creator" />

                <TextView style="@style/Body" android:textSize="16sp" android:text="@string/about_thanks" />

                <!-- GPL-3.0 legal notice; the attribution must stay in any distributed version (NOTICE). -->
                <TextView style="@style/Body" android:textSize="12sp" android:paddingTop="12dp" android:text="@string/about_license" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/page_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/Heading" android:text="@string/about_account_title" />

                <TextView style="@style/Body" android:textSize="16sp" android:text="@string/about_account_body" />

                <TextView style="@style/Body" android:textSize="16sp" android:paddingTop="12dp" android:text="@string/about_account_phone" />

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/about_account_url"
                    android:scaleType="fitCenter"
                    android:src="@drawable/qr_join" />

                <TextView style="@style/Body" android:gravity="center" android:textStyle="bold" android:text="@string/about_account_url" />
            </LinearLayout>
        </FrameLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/back" style="@style/PagerButton" android:text="@string/back" />

            <TextView android:id="@+id/previous" style="@style/PagerButton" android:text="@string/previous" />

            <TextView
                android:id="@+id/page_label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp" />

            <TextView android:id="@+id/next" style="@style/PagerButton" android:text="@string/next" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
