<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView android:id="@+id/title" style="@style/Heading" android:paddingLeft="20dp" android:paddingRight="20dp" />

        <View style="@style/Divider" />

        <club.readme.android.reader.PageView
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp" />

        <View style="@style/Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/back" style="@style/PagerButton" android:text="@string/back" />

            <TextView android:id="@+id/previous" style="@style/PagerButton" android:text="@string/previous" />

            <TextView
                android:id="@+id/page_label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp" />

            <TextView android:id="@+id/next" style="@style/PagerButton" android:text="@string/next" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
