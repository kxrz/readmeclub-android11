<?xml version="1.0" encoding="utf-8"?>
<!-- A home tile: icon and badge (pill or sticker) on top; the section name, and an optional
     line under it, at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Ds.Tile"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:tint="@color/ds_on_button" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/badge" style="@style/Ds.Pill" android:visibility="invisible" />
    </LinearLayout>

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
        android:id="@+id/label"
        style="@style/Ds.Text"
        android:duplicateParentState="true"
        android:maxLines="1"
        android:textColor="@color/ds_on_button"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sub"
        style="@style/Ds.Mono"
        android:duplicateParentState="true"
        android:maxLines="1"
        android:textColor="@color/ds_on_button"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
