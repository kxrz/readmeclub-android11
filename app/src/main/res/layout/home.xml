<?xml version="1.0" encoding="utf-8"?>
<!-- Home: the entry to every section (replaces the 1.x tabs). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_paper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="@dimen/ds_gutter"
        android:paddingTop="12dp"
        android:paddingRight="@dimen/ds_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Ds.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/app_name" />

            <!-- The member number, once this reader is linked. -->
            <TextView android:id="@+id/member_pill" style="@style/Ds.Pill" android:textAllCaps="false" android:visibility="gone" />
        </LinearLayout>

        <!-- Continue reading (the article or guide left half-read) or, before any, Start reading
             (the latest news): a window card, its label in a strip over the title. -->
        <LinearLayout
            android:id="@+id/continue_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/ds_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingRight="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/continue_label"
                    style="@style/Ds.Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:duplicateParentState="true"
                    android:textColor="@color/ds_on_button" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/ds_dot"
                    android:duplicateParentState="true" />
            </LinearLayout>

            <View style="@style/Divider" android:duplicateParentState="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/continue_title"
                    style="@style/Ds.Title"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/ds_on_button"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/continue_meta"
                    style="@style/Ds.Mono"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true"
                    android:textColor="@color/ds_on_button" />

                <!-- Progress as ten squares: e-ink friendly, no colour. -->
                <TextView
                    android:id="@+id/continue_bar"
                    style="@style/Ds.Mono"
                    android:duplicateParentState="true"
                    android:letterSpacing="0.1"
                    android:textColor="@color/ds_on_button" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout style="@style/HomeRow">
                <include android:id="@+id/tile_news" layout="@layout/home_tile" />
                <View android:layout_width="10dp" android:layout_height="0dp" />
                <include android:id="@+id/tile_guides" layout="@layout/home_tile" />
            </LinearLayout>

            <LinearLayout style="@style/HomeRow">
                <include android:id="@+id/tile_wallpapers" layout="@layout/home_tile" />
                <View android:layout_width="10dp" android:layout_height="0dp" />
                <include android:id="@+id/tile_games" layout="@layout/home_tile" />
            </LinearLayout>

            <LinearLayout style="@style/HomeRow">
                <include android:id="@+id/tile_member" layout="@layout/home_tile" />
                <View android:layout_width="10dp" android:layout_height="0dp" />
                <include android:id="@+id/tile_settings" layout="@layout/home_tile" />
            </LinearLayout>
        </LinearLayout>

        <!-- Two decorations in the space left under the tiles (none when there is no room). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="noHideDescendants">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|start"
                android:layout_marginLeft="12dp"
                android:layout_marginBottom="14dp"
                android:src="@drawable/ds_deco_zigzag" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:src="@drawable/ds_deco_plus" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout style="@style/Ds.Bar">

        <TextView
            android:id="@+id/home_status"
            style="@style/Ds.BarStatus"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical|start"
            android:paddingLeft="4dp" />

        <TextView android:id="@+id/sync" style="@style/Ds.Button.Primary" android:layout_marginLeft="8dp"
            android:text="@string/sync" />
    </LinearLayout>
</LinearLayout>
