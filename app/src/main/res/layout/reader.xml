<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <club.readme.android.reader.PageView
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp" />

        <!-- Always on screen: many readers have no button to open the menu or go back. -->
        <View style="@style/Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/bar_back" style="@style/PagerButton" android:text="@string/back" />

            <TextView
                android:id="@+id/page_number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="13sp" />

            <TextView android:id="@+id/bar_menu" style="@style/PagerButton" android:text="@string/menu" />
        </LinearLayout>
    </LinearLayout>

    <!-- Menu: Menu in the bottom bar, a tap in the middle of the page or a long press on the button. -->
    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:visibility="gone">

        <View style="@style/Divider" />

        <TextView android:id="@+id/open_contents" style="@style/Button" android:layout_height="56dp" android:text="@string/contents" android:visibility="gone" />

        <TextView android:id="@+id/open_qr" style="@style/Button" android:layout_height="56dp" android:text="@string/open_on_phone" />

        <TextView android:id="@+id/back" style="@style/Button" android:layout_height="56dp" android:text="@string/back" />
    </LinearLayout>

    <!-- Contents of a guide: one section per row, paginated. -->
    <LinearLayout
        android:id="@+id/contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:clickable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView style="@style/Heading" android:paddingLeft="20dp" android:text="@string/contents" />

        <View style="@style/Divider" />

        <LinearLayout
            android:id="@+id/contents_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <View style="@style/Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/contents_previous" style="@style/PagerButton" android:text="@string/previous" />

            <TextView android:id="@+id/contents_close" style="@style/PagerButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/back" />

            <TextView android:id="@+id/contents_next" style="@style/PagerButton" android:text="@string/next" />
        </LinearLayout>
    </LinearLayout>

    <!-- "Open on your phone": a QR code of the page on readme.club. Tap anywhere to close. -->
    <LinearLayout
        android:id="@+id/qr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView style="@style/Heading" android:layout_width="wrap_content" android:text="@string/open_on_phone" />

        <TextView style="@style/Body" android:layout_width="wrap_content" android:gravity="center" android:text="@string/scan_to_open" />

        <ImageView
            android:id="@+id/qr_image"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/open_on_phone"
            android:scaleType="fitCenter" />

        <TextView android:id="@+id/qr_url" style="@style/Body" android:layout_width="wrap_content" android:gravity="center" android:textSize="13sp" />

        <TextView style="@style/Body" android:layout_width="wrap_content" android:paddingTop="16dp" android:textSize="13sp" android:text="@string/tap_to_close" />
    </LinearLayout>

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
