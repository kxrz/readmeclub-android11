<?xml version="1.0" encoding="utf-8"?>
<!-- A quiz round: question and four answers; then the same answers marked, and why; then
     the score, the questions missed, and where to go next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Everything above the bar; it takes the space left, so the bar is always laid out. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pack"
                    style="@style/Ds.Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView android:id="@+id/progress" style="@style/Ds.Pill" />
            </LinearLayout>

            <!-- Question and answers. -->
            <LinearLayout
                android:id="@+id/play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:id="@+id/theme" style="@style/Ds.Label" android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/question"
                    style="@style/Ds.Text"
                    android:paddingTop="4dp"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/answers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp">

                    <TextView android:id="@+id/a0" style="@style/Ds.Choice" android:layout_marginBottom="8dp" android:maxLines="2" />

                    <TextView android:id="@+id/a1" style="@style/Ds.Choice" android:layout_marginBottom="8dp" android:maxLines="2" />

                    <TextView android:id="@+id/a2" style="@style/Ds.Choice" android:layout_marginBottom="8dp" android:maxLines="2" />

                    <TextView android:id="@+id/a3" style="@style/Ds.Choice" android:maxLines="2" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/ds_button"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingTop="8dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <TextView style="@style/Ds.Label" android:text="@string/quiz_why" />

                    <TextView
                        android:id="@+id/why"
                        style="@style/Ds.Text"
                        android:paddingTop="2dp"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/added"
                    style="@style/Ds.Mono"
                    android:layout_marginTop="8dp"
                    android:text="@string/quiz_added"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The score. -->
            <LinearLayout
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    style="@style/Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView android:id="@+id/verdict" style="@style/Ds.Label" />

                    <TextView
                        android:id="@+id/score"
                        style="@style/Ds.Mono"
                        android:textSize="44sp" />

                    <TextView android:id="@+id/comment" style="@style/Ds.Text" android:layout_width="wrap_content" android:textStyle="bold" />

                    <TextView android:id="@+id/score_meta" style="@style/Ds.Mono" android:paddingTop="2dp" />
                </LinearLayout>

                <TextView android:id="@+id/missed_label" style="@style/Ds.Label" android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/missed"
                    style="@style/Ds.Text"
                    android:paddingTop="4dp"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/review"
                        style="@style/Ds.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/ds_choice"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1"
                        android:text="@string/quiz_review" />

                    <TextView
                        android:id="@+id/other_packs"
                        style="@style/Ds.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/ds_choice"
                        android:layout_weight="1"
                        android:text="@string/quiz_other_packs" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Ds.Bar">

            <TextView android:id="@+id/back" style="@style/Ds.Button" android:text="@string/back" />

            <TextView android:id="@+id/status" style="@style/Ds.BarStatus" />

            <TextView android:id="@+id/primary" style="@style/Ds.Button.Primary" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
