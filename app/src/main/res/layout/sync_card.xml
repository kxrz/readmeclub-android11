<?xml version="1.0" encoding="utf-8"?>
<!-- Card at the top of News: "fetching" while a sync runs (so a first launch never looks empty),
     and the update / updated cards that open the release notes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/news_item_height"
    android:background="@drawable/brand_tile_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp">

    <TextView
        android:id="@+id/sync_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/sync_card_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sync_card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingTop="2dp"
        android:text="@string/sync_card_body"
        android:textSize="13sp" />
</LinearLayout>
