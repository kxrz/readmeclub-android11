<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/tab_wallpapers"
            android:fontFamily="@font/space_grotesk_bold"
            android:textSize="22sp" />

        <!-- Tap to reload (the "Retry" when offline). -->
        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/inverting_bg"
            android:gravity="center_vertical|end"
            android:textColor="@color/tab_text"
            android:textSize="13sp" />
    </LinearLayout>

    <View style="@style/Divider" />

    <!-- Search (the keyboard's search key runs it) and sort. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/ds_gutter"
        android:paddingTop="8dp"
        android:paddingRight="@dimen/ds_gutter">

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="@dimen/ds_touch"
            android:layout_weight="1"
            android:background="@drawable/ds_button"
            android:hint="@string/search_wallpapers"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:textColor="@color/ds_ink"
            android:textColorHint="@color/ds_ink"
            android:textSize="15sp" />

        <TextView android:id="@+id/clear" style="@style/Ds.Button" android:layout_marginLeft="8dp"
            android:text="@string/clear" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sorts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/ds_gutter"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp">

        <TextView style="@style/WallpaperSort" android:text="@string/sort_latest" />
        <TextView style="@style/WallpaperSort" android:text="@string/sort_popular" />
        <TextView style="@style/WallpaperSort" android:text="@string/sort_name" />
        <TextView style="@style/WallpaperSort" android:text="@string/sort_author" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3" />

    <LinearLayout style="@style/Ds.Bar">

        <TextView android:id="@+id/back" style="@style/Ds.Button" android:text="@string/back" />

        <TextView android:id="@+id/previous" style="@style/Ds.Button" android:layout_marginLeft="6dp" android:text="@string/previous" />

        <TextView
            style="@style/Ds.BarStatus"
            android:id="@+id/page_label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp" />

        <TextView android:id="@+id/next" style="@style/Ds.Button.Primary" android:text="@string/next" />
    </LinearLayout>
</LinearLayout>
