<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <!-- Page 1: Reading -->
        <LinearLayout
            android:id="@+id/page_reading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Heading" android:text="@string/reading" />

            <TextView style="@style/Body" android:text="@string/text_size" />
            <LinearLayout android:id="@+id/text_size_choices" style="@style/ChoiceRow" />

            <TextView style="@style/Body" android:text="@string/font" />
            <LinearLayout android:id="@+id/font_choices" style="@style/ChoiceRow" />

            <TextView style="@style/Body" android:text="@string/refresh_every" />
            <LinearLayout android:id="@+id/refresh_choices" style="@style/ChoiceRow" />
        </LinearLayout>

        <!-- Page 2: Sync & storage -->
        <LinearLayout
            android:id="@+id/page_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/Heading" android:text="@string/sync" />

            <LinearLayout style="@style/ChoiceRow">
                <TextView android:id="@+id/last_sync" style="@style/RowLabel" />
                <TextView android:id="@+id/sync_now" style="@style/RowButton" android:text="@string/sync_now" />
            </LinearLayout>

            <TextView style="@style/Heading" android:paddingTop="16dp" android:text="@string/storage" />

            <LinearLayout style="@style/ChoiceRow">
                <TextView style="@style/RowLabel" android:text="@string/tab_news" />
                <TextView android:id="@+id/size_news" style="@style/RowValue" />
                <TextView android:id="@+id/clear_news" style="@style/RowButton" android:text="@string/clear" />
            </LinearLayout>

            <LinearLayout style="@style/ChoiceRow">
                <TextView style="@style/RowLabel" android:text="@string/tab_guides" />
                <TextView android:id="@+id/size_guides" style="@style/RowValue" />
                <TextView android:id="@+id/clear_guides" style="@style/RowButton" android:text="@string/clear" />
            </LinearLayout>

            <LinearLayout style="@style/ChoiceRow">
                <TextView style="@style/RowLabel" android:text="@string/tab_wallpapers" />
                <TextView android:id="@+id/size_wallpapers" style="@style/RowValue" />
                <TextView android:id="@+id/clear_wallpapers" style="@style/RowButton" android:text="@string/clear" />
            </LinearLayout>
        </LinearLayout>

        <!-- Page 3: About -->
        <LinearLayout
            android:id="@+id/page_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/Heading" android:text="@string/about" />

            <TextView
                android:id="@+id/about"
                style="@style/Button"
                android:gravity="center_vertical"
                android:paddingLeft="8dp"
                android:text="@string/about_open" />

            <TextView android:id="@+id/version" style="@style/Body" />

            <TextView android:id="@+id/manifest_status" style="@style/Body" android:text="@string/loading" />

            <TextView android:id="@+id/update_now" style="@style/Button" android:visibility="gone" />

            <TextView android:id="@+id/check_update" style="@style/Button" android:text="@string/check_update" />
        </LinearLayout>
    </FrameLayout>

    <View style="@style/Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/previous" style="@style/PagerButton" android:text="@string/previous" />

        <TextView
            android:id="@+id/page_label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp" />

        <TextView android:id="@+id/next" style="@style/PagerButton" android:text="@string/next" />
    </LinearLayout>
</LinearLayout>
