<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/tab_news"
            android:fontFamily="@font/space_grotesk_bold"
            android:textSize="22sp" />

        <!-- Sync status; tap to sync now (also the "Retry" when offline). -->
        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/inverting_bg"
            android:gravity="center_vertical|end"
            android:textColor="@color/tab_text"
            android:textSize="13sp" />
    </LinearLayout>

    <View style="@style/Divider" />

    <LinearLayout
        android:id="@+id/items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <LinearLayout style="@style/Ds.Bar">

        <TextView android:id="@+id/back" style="@style/Ds.Button" android:text="@string/back" />

        <TextView android:id="@+id/previous" style="@style/Ds.Button" android:layout_marginLeft="6dp" android:text="@string/previous" />

        <TextView
            style="@style/Ds.BarStatus"
            android:id="@+id/page_label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp" />

        <TextView android:id="@+id/next" style="@style/Ds.Button.Primary" android:text="@string/next" />
    </LinearLayout>
</LinearLayout>
